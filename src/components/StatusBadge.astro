---
interface Props {
  status: 'spark' | 'active' | 'paused' | 'shipped' | 'abandoned';
}

const { status } = Astro.props;

const labels: Record<Props['status'], string> = {
  spark: 'spark',
  active: 'active',
  paused: 'paused',
  shipped: 'shipped',
  abandoned: 'let go',
};
---

<span class={`badge badge-${status}`}>{labels[status]}</span>

<style>
  .badge {
    display: inline-block;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    line-height: 1;
    padding: 0.3em 0.6em;
    border-radius: var(--radius-sm);
    border: 1px solid currentColor;
    text-transform: lowercase;
  }
  .badge-spark {
    color: var(--status-spark);
  }
  .badge-active {
    color: var(--status-active);
  }
  .badge-paused {
    color: var(--status-paused);
  }
  .badge-shipped {
    color: var(--status-shipped);
  }
  .badge-abandoned {
    color: var(--status-abandoned);
  }
</style>
