---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { href } from '../../lib/url';
import { fmtDate } from '../../lib/format';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry('projects', slug!);
if (!entry) {
  return Astro.redirect(href('projects'));
}
const { Content } = await render(entry);

// Log entries that reference this project.
const related = (await getCollection('log'))
  .filter((l) => l.data.project === entry.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <a class="back muted" href={href('projects')}>← projects</a>
  <div class="title-row">
    <h1>{entry.data.title}</h1>
    <StatusBadge status={entry.data.status} />
  </div>
  <p class="meta muted">
    {entry.data.started && <span>started {fmtDate(entry.data.started)}</span>}
    {entry.data.updated && <span> · touched {fmtDate(entry.data.updated)}</span>}
  </p>
  {
    entry.data.tags.length > 0 && (
      <p>
        {entry.data.tags.map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
      </p>
    )
  }

  <article class="prose">
    <Content />
  </article>

  {
    related.length > 0 && (
      <section class="section related">
        <h2>Log entries</h2>
        <ul>
          {related.map((l) => (
            <li>
              <a href={href(`log/${l.id}`)}>{l.data.title ?? fmtDate(l.data.date)}</a>
              <span class="muted"> — {fmtDate(l.data.date)}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <style>
    .back {
      display: inline-block;
      margin-bottom: var(--space-4);
      font-size: var(--text-sm);
    }
    .title-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
    }
    .meta {
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      margin-top: var(--space-1);
    }
    .related {
      margin-top: var(--space-12);
      padding-top: var(--space-4);
      border-top: var(--border);
    }
    .related ul {
      padding-left: var(--space-4);
    }
  </style>
</BaseLayout>
